#!/bin/bash
# Paper Rewriter — Entry point
# Launches the TypeScript Ink TUI. No fallback.

SCRIPT_PATH="$(readlink -f "$0")"
PROJECT_DIR="$(dirname "$SCRIPT_PATH")"
TUI_DIR="$PROJECT_DIR/tui"
NODE="/home/lex/.hermes/node/bin/node"

# Check node
if [ ! -f "$NODE" ]; then
    echo "Error: Node.js not found at $NODE"
    echo "Install: curl -fsSL https://nodejs.org/dist/v22.0.0/node-v22.0.0-linux-x64.tar.xz | tar -xJ -C /usr/local"
    exit 1
fi

# Check if AG-UI backend is running
if ! curl -s --connect-timeout 2 --max-time 3 http://localhost:8765/api/status >/dev/null 2>&1; then
    echo "Starting AG-UI backend..."
    cd "$PROJECT_DIR"
    python3 -B -m agent.server_agui &
    BACKEND_PID=$!
    
    for i in $(seq 1 30); do
        if curl -s --connect-timeout 2 --max-time 3 http://localhost:8765/api/status >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done
    
    if ! curl -s --connect-timeout 2 --max-time 3 http://localhost:8765/api/status >/dev/null 2>&1; then
        echo "Error: AG-UI backend failed to start on port 8765."
        echo "Start manually: cd $PROJECT_DIR && python3 -B -m agent.server_agui"
        exit 1
    fi
fi

# Build TUI if needed
if [ ! -f "$TUI_DIR/dist/entry.js" ]; then
    echo "Building TUI..."
    cd "$TUI_DIR" && "$NODE" scripts/build.mjs
    if [ $? -ne 0 ]; then
        echo "Error: TUI build failed."
        echo "Fix: cd $TUI_DIR && $NODE scripts/build.mjs"
        exit 1
    fi
fi

# Launch TUI
cd "$PROJECT_DIR"
exec "$NODE" "$TUI_DIR/dist/entry.js" "$@"
